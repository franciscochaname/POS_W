@if (!IsConfigured)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
        @Message
    </MudAlert>
}

@code {
    [Parameter]
    public bool IsConfigured { get; set; }

    [Parameter]
    public string Message { get; set; } = "Configura la cadena de conexion para leer datos reales de MySQL.";
}
