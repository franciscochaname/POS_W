@page "/caja"
@inject OperatorAccessService Access

<PageTitle>Caja y arqueo - POS</PageTitle>

@if (!Access.CanAccess("caja", Access.CurrentOperator.Role))
{
    <AccessDenied ModuleName="Caja" />
}
else
{
    <section class="page-heading">
        <div>
            <span class="eyebrow">Caja y arqueo</span>
            <h1>Control de caja</h1>
            <p>Apertura, ingresos, egresos, retiros, arqueo y cierre por turno.</p>
        </div>
        <div class="action-row">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Calculate">Arqueo</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.LockOpen">Abrir caja</MudButton>
        </div>
    </section>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="4">
            <MudPaper Class="metric-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Rounded.AccountBalanceWallet" Color="Color.Primary" />
                <span>Saldo inicial</span>
                <strong>S/ 0.00</strong>
                <small>Asociado al turno activo</small>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="metric-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Rounded.Payments" Color="Color.Success" />
                <span>Efectivo esperado</span>
                <strong>S/ 0.00</strong>
                <small>Ventas + ingresos - retiros</small>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="metric-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Rounded.Warning" Color="Color.Warning" />
                <span>Diferencia</span>
                <strong>S/ 0.00</strong>
                <small>Resultado de arqueo</small>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3" Class="mt-1">
        <MudItem xs="12" lg="7">
            <MudPaper Class="work-panel" Elevation="0">
                <div class="panel-title">
                    <div>
                        <h2>Movimientos del turno</h2>
                        <p>Los cajeros y griferos trabajan aqui con su caja o isla asignada.</p>
                    </div>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">pos_movimientos_caja</MudChip>
                </div>
                <MudTable Items="_movements" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Concepto</MudTh>
                        <MudTh>Medio</MudTh>
                        <MudTh Class="text-right">Monto</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tipo">@context.Type</MudTd>
                        <MudTd DataLabel="Concepto">@context.Concept</MudTd>
                        <MudTd DataLabel="Medio">@context.Method</MudTd>
                        <MudTd DataLabel="Monto" Class="text-right">@context.Amount</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="5">
            <MudPaper Class="work-panel" Elevation="0">
                <div class="panel-title">
                    <div>
                        <h2>Limites por rol</h2>
                        <p>Acciones disponibles para perfiles operativos.</p>
                    </div>
                </div>
                <MudList T="string" Dense="true">
                    <MudListItem Icon="@Icons.Material.Rounded.PointOfSale">Cajero: POS, clientes, comprobantes y caja.</MudListItem>
                    <MudListItem Icon="@Icons.Material.Rounded.LocalGasStation">Grifero: combustible, lecturas, despachos y caja asignada.</MudListItem>
                    <MudListItem Icon="@Icons.Material.Rounded.Lock">Anulaciones, descuentos altos y cierres requieren autorizacion.</MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private readonly CashMovement[] _movements =
    [
        new("Apertura", "Saldo inicial del turno", "Efectivo", "S/ 0.00"),
        new("Venta", "Venta minimarket o combustible", "Mixto", "S/ 0.00"),
        new("Arqueo", "Conteo al cierre", "Efectivo", "S/ 0.00")
    ];

    private sealed record CashMovement(string Type, string Concept, string Method, string Amount);
}
