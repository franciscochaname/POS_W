@page "/clientes"
@inject ClientService Clients
@inject ApiPeruIdentityService IdentityLookup
@inject OperatorAccessService Access
@inject ISnackbar Snackbar

<PageTitle>Clientes - POS</PageTitle>

@if (!Access.CanAccess("clientes", Access.CurrentOperator.Role))
{
    <AccessDenied ModuleName="Clientes" />
}
else
{
    <section class="page-heading">
        <div>
            <span class="eyebrow">Identificacion</span>
            <h1>Clientes</h1>
            <p>DNI, RUC, contacto y direccion fiscal para ventas y comprobantes.</p>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="LoadAsync">
            Actualizar
        </MudButton>
    </section>

    @if (_workspace is null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <DatabaseNotice IsConfigured="_workspace.DatabaseConfigured" Message="@_workspace.StatusMessage" />

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="4">
                <MudPaper Class="metric-card compact" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Rounded.Groups" Color="Color.Primary" />
                    <span>Clientes activos</span>
                    <strong>@_workspace.Clientes.Count(x => x.Estado == "activo")</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="metric-card compact" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Rounded.Badge" Color="Color.Secondary" />
                    <span>DNI</span>
                    <strong>@_workspace.Clientes.Count(x => x.DocumentoTipo == "DNI")</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="metric-card compact" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Rounded.Business" Color="Color.Tertiary" />
                    <span>RUC</span>
                    <strong>@_workspace.Clientes.Count(x => x.DocumentoTipo == "RUC")</strong>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3" Class="mt-1">
            <MudItem xs="12" lg="4">
                <MudPaper Class="form-panel" Elevation="0">
                    <h2>Registrar cliente</h2>
                    <div class="split-fields">
                        <MudSelect T="string" @bind-Value="_client.DocumentoTipo" Label="Documento" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@("DNI")">DNI</MudSelectItem>
                            <MudSelectItem T="string" Value="@("RUC")">RUC</MudSelectItem>
                            <MudSelectItem T="string" Value="@("CE")">CE</MudSelectItem>
                            <MudSelectItem T="string" Value="@("PASAPORTE")">Pasaporte</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="_client.DocumentoNumero" Label="Numero" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Search" OnClick="LookupClientDocumentAsync" Disabled="_lookingUpClient || !CanLookupDocument">
                        @(_lookingUpClient ? "Consultando..." : "Consultar documento")
                    </MudButton>
                    <MudTextField @bind-Value="_client.RazonSocialNombre" Label="Nombre o razon social" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="_client.Direccion" Label="Direccion" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                    <div class="split-fields">
                        <MudTextField @bind-Value="_client.Email" Label="Correo" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="_client.Telefono" Label="Telefono" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Save" OnClick="SaveClientAsync">
                        Guardar cliente
                    </MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" lg="8">
                <MudPaper Class="work-panel" Elevation="0">
                    <div class="panel-title">
                        <div>
                            <h2>Base de clientes</h2>
                            <p>Registros leidos desde `pos_clientes`.</p>
                        </div>
                        <MudTextField @bind-Value="_search" Placeholder="Buscar" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                    </div>
                    <MudTable Items="FilteredClients" Dense="true" Hover="true" Elevation="0" Class="data-table">
                        <HeaderContent>
                            <MudTh>Documento</MudTh>
                            <MudTh>Cliente</MudTh>
                            <MudTh>Direccion</MudTh>
                            <MudTh>Contacto</MudTh>
                            <MudTh>Estado</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Documento">@context.DocumentoTipo @context.DocumentoNumero</MudTd>
                            <MudTd DataLabel="Cliente"><strong>@context.RazonSocialNombre</strong></MudTd>
                            <MudTd DataLabel="Direccion">@Display(context.Direccion)</MudTd>
                            <MudTd DataLabel="Contacto">@Contact(context)</MudTd>
                            <MudTd DataLabel="Estado">
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@context.Estado</MudChip>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary">No hay clientes registrados.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
}

@code {
    private ClientWorkspace? _workspace;
    private ClientForm _client = new();
    private string _search = "";
    private bool _lookingUpClient;
    private bool CanLookupDocument => _client.DocumentoTipo is "DNI" or "RUC";

    private IEnumerable<ClientItem> FilteredClients
    {
        get
        {
            if (_workspace is null)
            {
                return [];
            }

            if (string.IsNullOrWhiteSpace(_search))
            {
                return _workspace.Clientes;
            }

            var term = _search.Trim();
            return _workspace.Clientes.Where(x =>
                x.DocumentoNumero.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                x.RazonSocialNombre.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _workspace = await Clients.GetWorkspaceAsync();
    }

    private async Task SaveClientAsync()
    {
        var result = await Clients.CreateClientAsync(_client);
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Warning);
        if (result.Success)
        {
            _client = new();
            await LoadAsync();
        }
    }

    private async Task LookupClientDocumentAsync()
    {
        if (!CanLookupDocument)
        {
            Snackbar.Add("La consulta automatica esta disponible para DNI y RUC.", Severity.Info);
            return;
        }

        _lookingUpClient = true;
        var result = _client.DocumentoTipo == "RUC"
            ? await IdentityLookup.LookupRucAsync(_client.DocumentoNumero)
            : await IdentityLookup.LookupDniAsync(_client.DocumentoNumero);
        _lookingUpClient = false;

        if (!result.Success || result.Data is null)
        {
            Snackbar.Add(result.Message, Severity.Warning);
            return;
        }

        _client.DocumentoTipo = result.Data.DocumentType;
        _client.DocumentoNumero = result.Data.DocumentNumber;
        _client.RazonSocialNombre = result.Data.FullName;
        _client.Direccion = result.Data.Address;
        Snackbar.Add("Datos cargados desde API Peru.", Severity.Success);
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string Contact(ClientItem item)
    {
        var parts = new[] { item.Telefono, item.Email }.Where(x => !string.IsNullOrWhiteSpace(x));
        var value = string.Join(" / ", parts);
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }
}
