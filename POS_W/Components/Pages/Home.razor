@page "/"

<PageTitle>Dashboard - POS</PageTitle>

<section class="page-heading">
    <div>
        <span class="eyebrow">Operacion diaria</span>
        <h1>Dashboard</h1>
        <p>Resumen inicial para ventas, combustible, caja e inventario.</p>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.PointOfSale">
        Abrir POS
    </MudButton>
</section>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="metric-card" Elevation="0">
            <MudIcon Icon="@Icons.Material.Rounded.Payments" Color="Color.Primary" />
            <span>Ventas del dia</span>
            <strong>S/ 0.00</strong>
            <small>Pendiente de datos reales</small>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="metric-card" Elevation="0">
            <MudIcon Icon="@Icons.Material.Rounded.LocalGasStation" Color="Color.Tertiary" />
            <span>Combustible</span>
            <strong>0.0000 gal</strong>
            <small>Despachos registrados hoy</small>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="metric-card" Elevation="0">
            <MudIcon Icon="@Icons.Material.Rounded.Inventory2" Color="Color.Secondary" />
            <span>Stock bajo</span>
            <strong>0</strong>
            <small>Productos por reponer</small>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="metric-card" Elevation="0">
            <MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" Color="Color.Success" />
            <span>Comprobantes</span>
            <strong>0</strong>
            <small>Pendientes de SUNAT</small>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid Spacing="3" Class="mt-1">
    <MudItem xs="12" lg="7">
        <MudPaper Class="work-panel" Elevation="0">
            <div class="panel-title">
                <div>
                    <h2>Flujo POS prioritario</h2>
                    <p>Primera ruta de construccion por modulo.</p>
                </div>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">Fase 1</MudChip>
            </div>
            <MudList T="string" Dense="true">
                <MudListItem Icon="@Icons.Material.Rounded.CheckCircle">Layout principal con barra lateral y libreria visual.</MudListItem>
                <MudListItem Icon="@Icons.Material.Rounded.RadioButtonUnchecked">Conexion EF Core a MySQL POS.</MudListItem>
                <MudListItem Icon="@Icons.Material.Rounded.RadioButtonUnchecked">Configuracion, seguridad y catalogo base.</MudListItem>
                <MudListItem Icon="@Icons.Material.Rounded.RadioButtonUnchecked">Venta transaccional: detalle, kardex, caja y comprobante.</MudListItem>
            </MudList>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="5">
        <MudPaper Class="work-panel" Elevation="0">
            <div class="panel-title">
                <div>
                    <h2>Estado tecnico</h2>
                    <p>Base para que el equipo avance sin desviarse.</p>
                </div>
            </div>
            <div class="status-row">
                <span>Stack</span>
                <strong>C# + Blazor + MudBlazor</strong>
            </div>
            <div class="status-row">
                <span>Base de datos</span>
                <strong>MySQL / POS</strong>
            </div>
            <div class="status-row">
                <span>Migracion inicial</span>
                <strong>35 tablas, 82 FK</strong>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
